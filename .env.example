# Required Galileo SDK settings. Put real values in ~/.hermes/.env.
GALILEO_API_KEY=
GALILEO_PROJECT=hermes-agent
GALILEO_LOG_STREAM=development

# For a self-hosted or non-default Galileo deployment, set both endpoints.
# GALILEO_CONSOLE_URL=https://console.example.com
# GALILEO_API_URL is required whenever GALILEO_CONSOLE_URL is set.
# GALILEO_API_URL=https://api.example.com

# Content is private by default. Enabling this still applies secret redaction.
HERMES_GALILEO_CAPTURE_CONTENT=false
HERMES_GALILEO_CAPTURE_CONVERSATION_HISTORY=false

# Recommended in production so pseudonym stability is independent of API-key rotation.
# HERMES_GALILEO_PSEUDONYM_SECRET=

HERMES_GALILEO_SAMPLE_RATE=1.0
HERMES_GALILEO_ENVIRONMENT=development
